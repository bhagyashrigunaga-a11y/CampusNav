# Server Port
PORT=5000
NODE_ENV=development

# Local administrator access (set these in backend/.env; never commit the real values)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_TOKEN_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Database Configuration (Leave empty to use zero-setup local storage, or configure for AWS RDS MySQL)
DB_TYPE=local
# DB_TYPE=mysql
# DB_HOST=campusnav-db.xxxxxx.ap-south-1.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=YourSecurePassword
# DB_NAME=campusnav

# AWS Credentials (Optional for local testing; needed when connecting directly to AWS S3 & CloudWatch)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# AWS_SECRET_ACCESS_KEY=YYYYYYYYYYYYYYYYYYYYYYYYYYYYYYYY
# CAMPUSNAV_S3_BUCKET=campusnav-floor-plans-rvu
